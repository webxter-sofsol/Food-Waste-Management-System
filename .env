# ─── Email Configuration ───────────────────────────────────────────────────────
# To send real emails, change EMAIL_BACKEND to smtp and fill in the credentials.
#
# Gmail (App Password) example:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.hostinger.com
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=info@webxter.in
#   EMAIL_HOST_PASSWORD=
#   DEFAULT_FROM_EMAIL=FoodShare <youraddress@gmail.com>
#
# Outlook / Office 365 example:
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#
# While EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are empty the console backend is
# used automatically so the reset link prints to the Django terminal.
# ──────────────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@webxter.in
EMAIL_HOST_PASSWORD=MagicShow@123
DEFAULT_FROM_EMAIL=FoodShare <noreply@foodshare.com>

# Frontend URL (used in password-reset email link)
FRONTEND_URL=http://localhost:5173

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1

